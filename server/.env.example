# eBay Developer Credentials
# Obtenlas en: https://developer.ebay.com/my/keys (Sandbox o Production)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_ENVIRONMENT=PRODUCTION
# Global ID para España: EBAY-ES (o EBAY-US, EBAY-GB, EBAY-DE)
EBAY_GLOBAL_ID=EBAY-ES

# Redis para Deduplicación y Colas BullMQ (Opcional, si no se indica usa memoria local)
REDIS_URL=redis://localhost:6379
